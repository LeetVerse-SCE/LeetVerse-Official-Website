# Server Configuration
PORT=5000
NODE_ENV=development

# Allowed CORS Origins (comma separated)
FRONTEND_URL=http://localhost:5173,http://localhost:3000

# Firebase Admin Credentials (Option A: Split fields)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Firebase Admin Credentials (Option B: JSON string alternative)
# FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"..."}'

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Vercel Blob Storage Token (Required for Cache Refresh Script)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxxxxxxxxxx

# MOM Generator Integration
# Google Application Credentials path or Base64 encoded service account JSON
GOOGLE_APPLICATION_CREDENTIALS=./leetverse-website-firebase-adminsdk-fbsvc-291a2e70fe.json
# MOM_SHEETS_CREDENTIALS_B64=eyJ0eXBlIjoic2VydmljZV9hY2NvdW50Ii...
MOM_SHEET_ID=your_production_google_sheet_id
MOM_TEST_SHEET_ID=your_test_google_sheet_id
MOM_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,https://mom.leetverse.in
MOM_MAX_DELEGATION_HOURS=168
MOM_DEFAULT_DELEGATION_HOURS=24
MOM_NONEXEC_MAX_PAST_DAYS=14
MOM_MAX_FUTURE_DAYS=1
